<?xml version="1.0" encoding="utf-8"?>
<!--
  SEEA-Sim (package name: stsimseea)
  SyncroSim add-on that turns ST-Sim 4.5 output (state classes, transitions,
  stocks and flows) into SEEA Ecosystem Accounting tables.

  Syntax follows ApexRMS/stsimecodep (builtFor, no <dataSheets> wrapper, no
  explicit ID/ScenarioId columns) and ApexRMS/helloworldPy (Python transformer
  with condaEnv). ST-Sim datasheet and column names checked against
  ApexRMS/stsim src/package.xml, version 4.5.4.

  Run it as a second pipeline stage after stsim_Runtime.
-->
<package name="stsimseea" displayName="SEEA-Sim" description="SEEA Ecosystem Accounting tables from ST-Sim output" version="1.0.2" minSyncroSimVersion="3.1.14" url="https://github.com/Shlhnj/stsimseea">

  <builtFor package="stsim" version="4.5.4"/>

  <!-- ===================== Project definitions ===================== -->

  <dataSheet name="Service" displayName="Ecosystem Service" dataScope="Project" displayMember="Name">
    <column name="Name" dataType="String"/>
    <column name="ServiceType" displayName="Type" dataType="Integer" validationType="List" formula1="1:Provisioning|2:Regulating|3:Cultural"/>
    <column name="Units" displayName="Physical Units" dataType="String" isOptional="True"/>
    <column name="Description" dataType="String" isOptional="True"/>
  </dataSheet>

  <!-- ===================== Scenario inputs ===================== -->

  <dataSheet name="Options" displayName="Options" isSingleRow="True">
    <column name="ReportByStratum" displayName="Report by primary stratum (accounting area)" dataType="Boolean"/>
    <column name="Currency" dataType="String" isOptional="True"/>
  </dataSheet>

  <dataSheet name="AccountingPeriod" displayName="Accounting Periods">
    <column name="OpeningTimestep" displayName="Opening" dataType="Integer" validationType="WholeNumber" validationCondition="GreaterEqual" formula1="0" format="d" allowDbNull="False"/>
    <column name="ClosingTimestep" displayName="Closing" dataType="Integer" validationType="WholeNumber" validationCondition="GreaterEqual" formula1="0" format="d" allowDbNull="False"/>
    <validation validationType="Unique" columns="OpeningTimestep|ClosingTimestep"/>
  </dataSheet>

  <dataSheet name="TransitionTypeClass" displayName="Transition Type Classification">
    <column name="TransitionTypeId" displayName="Transition Type" dataType="Integer" validationType="Datasheet" formula1="stsim_TransitionType" allowDbNull="False"/>
    <column name="ChangeType" displayName="Change Type" dataType="Integer" validationType="List" formula1="1:Managed|2:Unmanaged|3:Catastrophic" allowDbNull="False"/>
    <validation validationType="Unique" columns="TransitionTypeId"/>
  </dataSheet>

  <dataSheet name="CarbonStockGroup" displayName="Carbon Stock Groups">
    <column name="StockGroupId" displayName="Stock Group" dataType="Integer" validationType="Datasheet" formula1="stsim_StockGroup" allowDbNull="False"/>
    <column name="Role" dataType="Integer" validationType="List" formula1="1:Ecosystem pool|2:Atmosphere|3:Water|4:Long-term burial|5:Other external" allowDbNull="False"/>
    <validation validationType="Unique" columns="StockGroupId"/>
  </dataSheet>

  <dataSheet name="CarbonFlowGroup" displayName="Carbon Flow Groups">
    <column name="FlowGroupId" displayName="Flow Group" dataType="Integer" validationType="Datasheet" formula1="stsim_FlowGroup" allowDbNull="False"/>
    <validation validationType="Unique" columns="FlowGroupId"/>
  </dataSheet>

  <dataSheet name="ServiceSupply" displayName="Service Supply Rules">
    <column name="ServiceId" displayName="Service" dataType="Integer" validationType="Datasheet" formula1="Service" allowDbNull="False"/>
    <column name="StratumId" displayName="Stratum" dataType="Integer" validationType="Datasheet" formula1="stsim_Stratum" isOptional="True"/>
    <column name="StateClassId" displayName="State Class" dataType="Integer" validationType="Datasheet" formula1="stsim_StateClass" isOptional="True"/>
    <column name="Basis" dataType="Integer" validationType="List" formula1="1:Area|2:Stock group|3:Flow group" allowDbNull="False"/>
    <column name="StockGroupId" displayName="Stock Group" dataType="Integer" validationType="Datasheet" formula1="stsim_StockGroup" isOptional="True"/>
    <column name="FlowGroupId" displayName="Flow Group" dataType="Integer" validationType="Datasheet" formula1="stsim_FlowGroup" isOptional="True"/>
    <column name="Coefficient" dataType="Double" allowDbNull="False"/>
  </dataSheet>

  <dataSheet name="ServicePrice" displayName="Service Prices" hasTimestep="True">
    <column name="ServiceId" displayName="Service" dataType="Integer" validationType="Datasheet" formula1="Service" allowDbNull="False"/>
    <column name="Price" displayName="Price per physical unit" dataType="Double" allowDbNull="False"/>
  </dataSheet>

  <dataSheet name="AssetValuation" displayName="Asset Valuation">
    <column name="StateClassId" displayName="State Class" dataType="Integer" validationType="Datasheet" formula1="stsim_StateClass" isOptional="True"/>
    <column name="DiscountRate" displayName="Discount Rate" dataType="Double" validationType="Decimal" validationCondition="GreaterEqual" formula1="0.0" allowDbNull="False"/>
    <column name="AssetLife" displayName="Asset Life (years)" dataType="Integer" validationType="WholeNumber" validationCondition="Greater" formula1="0" allowDbNull="False"/>
  </dataSheet>

  <!-- ===================== Outputs ===================== -->
  <!-- Sign convention: additions positive, reductions negative, so each
       account's Net change equals the sum of its change entries. -->

  <dataSheet name="OutputExtent" displayName="Extent Account" hasIteration="True">
    <column name="OpeningTimestep" dataType="Integer"/>
    <column name="ClosingTimestep" dataType="Integer"/>
    <column name="StratumId" dataType="Integer" validationType="Datasheet" formula1="stsim_Stratum" isOptional="True"/>
    <column name="StateClassId" dataType="Integer" validationType="Datasheet" formula1="stsim_StateClass"/>
    <column name="Entry" dataType="String"/>
    <column name="Amount" dataType="Double"/>
  </dataSheet>

  <dataSheet name="OutputChangeMatrix" displayName="Ecosystem Type Change Matrix" hasIteration="True">
    <column name="OpeningTimestep" dataType="Integer"/>
    <column name="ClosingTimestep" dataType="Integer"/>
    <column name="StratumId" dataType="Integer" validationType="Datasheet" formula1="stsim_Stratum" isOptional="True"/>
    <column name="FromStateClassId" dataType="Integer" validationType="Datasheet" formula1="stsim_StateClass"/>
    <column name="ToStateClassId" dataType="Integer" validationType="Datasheet" formula1="stsim_StateClass"/>
    <column name="Amount" dataType="Double"/>
  </dataSheet>

  <dataSheet name="OutputCarbonStock" displayName="Carbon Stock Account" hasIteration="True">
    <column name="OpeningTimestep" dataType="Integer"/>
    <column name="ClosingTimestep" dataType="Integer"/>
    <column name="StratumId" dataType="Integer" validationType="Datasheet" formula1="stsim_Stratum" isOptional="True"/>
    <column name="StateClassId" dataType="Integer" validationType="Datasheet" formula1="stsim_StateClass"/>
    <column name="StockGroupId" dataType="Integer" validationType="Datasheet" formula1="stsim_StockGroup"/>
    <column name="Entry" dataType="String"/>
    <column name="Amount" dataType="Double"/>
  </dataSheet>

  <dataSheet name="OutputCarbonFlow" displayName="Carbon Flow Account" hasIteration="True">
    <column name="OpeningTimestep" dataType="Integer"/>
    <column name="ClosingTimestep" dataType="Integer"/>
    <column name="StratumId" dataType="Integer" validationType="Datasheet" formula1="stsim_Stratum" isOptional="True"/>
    <column name="StateClassId" dataType="Integer" validationType="Datasheet" formula1="stsim_StateClass"/>
    <column name="TransitionTypeId" dataType="Integer" validationType="Datasheet" formula1="stsim_TransitionType" isOptional="True"/>
    <column name="FromStockTypeId" dataType="Integer" validationType="Datasheet" formula1="stsim_StockType"/>
    <column name="ToStockTypeId" dataType="Integer" validationType="Datasheet" formula1="stsim_StockType"/>
    <column name="Category" dataType="String"/>
    <column name="Amount" dataType="Double"/>
  </dataSheet>

  <dataSheet name="OutputServiceSupply" displayName="Physical Supply" hasIteration="True" hasTimestep="True">
    <column name="StratumId" dataType="Integer" validationType="Datasheet" formula1="stsim_Stratum" isOptional="True"/>
    <column name="StateClassId" dataType="Integer" validationType="Datasheet" formula1="stsim_StateClass"/>
    <column name="ServiceId" dataType="Integer" validationType="Datasheet" formula1="Service"/>
    <column name="Amount" dataType="Double"/>
  </dataSheet>

  <dataSheet name="OutputServiceValue" displayName="Monetary Supply" hasIteration="True" hasTimestep="True">
    <column name="StratumId" dataType="Integer" validationType="Datasheet" formula1="stsim_Stratum" isOptional="True"/>
    <column name="StateClassId" dataType="Integer" validationType="Datasheet" formula1="stsim_StateClass"/>
    <column name="ServiceId" dataType="Integer" validationType="Datasheet" formula1="Service"/>
    <column name="Amount" dataType="Double"/>
  </dataSheet>

  <dataSheet name="OutputAssetAccount" displayName="Monetary Asset Account" hasIteration="True">
    <column name="OpeningTimestep" dataType="Integer"/>
    <column name="ClosingTimestep" dataType="Integer"/>
    <column name="StratumId" dataType="Integer" validationType="Datasheet" formula1="stsim_Stratum" isOptional="True"/>
    <column name="StateClassId" dataType="Integer" validationType="Datasheet" formula1="stsim_StateClass"/>
    <column name="Entry" dataType="String"/>
    <column name="Amount" dataType="Double"/>
  </dataSheet>

  <dataSheet name="OutputCheck" displayName="Reconciliation Checks" hasIteration="True">
    <column name="Account" dataType="String"/>
    <column name="OpeningTimestep" dataType="Integer"/>
    <column name="ClosingTimestep" dataType="Integer"/>
    <column name="StratumId" dataType="Integer" validationType="Datasheet" formula1="stsim_Stratum" isOptional="True"/>
    <column name="Item" dataType="String"/>
    <column name="Residual" dataType="Double"/>
  </dataSheet>

  <!-- ===================== Transformer ===================== -->

  <transformer
    name="Main"
    displayName="SEEA-Sim Accounts"
    isRunnable="True"
    programName="python"
    programArguments="transformer.py"
    condaEnv="stsimseea.yml"
    condaEnvVersion="2">
      <dataSheet name="Options" type="Input"/>
      <dataSheet name="AccountingPeriod" type="Input"/>
      <dataSheet name="TransitionTypeClass" type="Input"/>
      <dataSheet name="CarbonStockGroup" type="Input"/>
      <dataSheet name="CarbonFlowGroup" type="Input"/>
      <dataSheet name="ServiceSupply" type="Input"/>
      <dataSheet name="ServicePrice" type="Input"/>
      <dataSheet name="AssetValuation" type="Input"/>
      <dataSheet name="OutputExtent" type="Output"/>
      <dataSheet name="OutputChangeMatrix" type="Output"/>
      <dataSheet name="OutputCarbonStock" type="Output"/>
      <dataSheet name="OutputCarbonFlow" type="Output"/>
      <dataSheet name="OutputServiceSupply" type="Output"/>
      <dataSheet name="OutputServiceValue" type="Output"/>
      <dataSheet name="OutputAssetAccount" type="Output"/>
      <dataSheet name="OutputCheck" type="Output"/>
  </transformer>

  <!-- ===================== Layouts ===================== -->

  <layout type="Project">
    <item name="Service"/>
  </layout>

  <layout type="Scenario">
    <group name="SEEASim" displayName="SEEA-Sim">
      <item name="Options"/>
      <item name="AccountingPeriod"/>
      <item name="TransitionTypeClass"/>
      <group name="Carbon">
        <item name="CarbonStockGroup"/>
        <item name="CarbonFlowGroup"/>
      </group>
      <group name="Services" displayName="Ecosystem Services">
        <item name="ServiceSupply"/>
        <item name="ServicePrice"/>
        <item name="AssetValuation"/>
      </group>
      <group name="Results">
        <item name="OutputExtent"/>
        <item name="OutputChangeMatrix"/>
        <item name="OutputCarbonStock"/>
        <item name="OutputCarbonFlow"/>
        <item name="OutputServiceSupply"/>
        <item name="OutputServiceValue"/>
        <item name="OutputAssetAccount"/>
        <item name="OutputCheck"/>
      </group>
    </group>
  </layout>

</package>
